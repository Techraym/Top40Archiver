[Unit]
Description=Top40Archiver veilige logreader
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/top40-archiver
Environment=PYTHONPATH=/opt/top40-archiver
ExecStart=/opt/top40-archiver/venv/bin/uvicorn app.log_reader_service:app --host 127.0.0.1 --port 8042 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
