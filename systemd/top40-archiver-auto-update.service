[Unit]
Description=Controleer en installeer Top40Archiver-update vanaf GitHub
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/local/sbin/top40-archiver-safe-update

[Service]
Type=oneshot
Environment=GIT_CONFIG_COUNT=1
Environment=GIT_CONFIG_KEY_0=safe.directory
Environment=GIT_CONFIG_VALUE_0=/opt/top40-archiver
ExecStart=/usr/local/sbin/top40-archiver-safe-update
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
