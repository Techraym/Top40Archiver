[Unit]
Description=Top40Archiver YouTube PO Token Provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=top40archiver
Group=top40archiver

Environment=HOME=/var/lib/top40-archiver
Environment=DENO_DIR=/var/lib/top40-archiver/.cache/deno

WorkingDirectory=/var/lib/top40-archiver/bgutil-ytdlp-pot-provider/server/node_modules

ExecStart=/usr/local/bin/deno run \
  --allow-env \
  --allow-net \
  --allow-ffi=. \
  --allow-read=. \
  ../src/main.ts

Restart=always
RestartSec=5

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
