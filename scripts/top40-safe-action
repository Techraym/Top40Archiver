#!/usr/bin/env python3
from __future__ import annotations

import json
import subprocess
import sys

ACTIONS = {
    "restart_web": ["systemctl", "restart", "top40-archiver-web.service"],
    "restart_download": ["systemctl", "restart", "top40-archiver-download.service"],
    "restart_ai": ["systemctl", "restart", "top40-archiver-ai.service"],
    "restart_ollama": ["systemctl", "restart", "ollama.service"],
    "restart_log_reader": ["systemctl", "restart", "top40-log-reader.service"],
    "repair_cover_timer": ["systemctl", "enable", "--now", "top40-archiver-cover-art.timer"],
    "repair_id3_cover_timer": ["systemctl", "enable", "--now", "top40-archiver-id3-cover.timer"],
    "repair_history_timer": ["systemctl", "enable", "--now", "top40-archiver-history.timer"],
    "repair_check_timer": ["systemctl", "enable", "--now", "top40-archiver-check.timer"],
    "repair_auto_update_timer": ["systemctl", "enable", "--now", "top40-archiver-auto-update.timer"],
    "repair_ai_recovery_timer": ["systemctl", "enable", "--now", "top40-ai-recovery.timer"],
    "repair_incident_timer": ["systemctl", "enable", "--now", "top40-archiver-incident-scan.timer"],
    "run_cover_art": ["systemctl", "start", "top40-archiver-cover-art.service"],
    "run_id3_cover": ["systemctl", "start", "top40-archiver-id3-cover.service"],
    "diagnostics": ["systemctl", "is-system-running"],
}


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in ACTIONS:
        print(json.dumps({"ok": False, "error": "action_not_allowed", "allowed": sorted(ACTIONS)}))
        return 2
    action = sys.argv[1]
    completed = subprocess.run(ACTIONS[action], capture_output=True, text=True, timeout=90, check=False)
    print(json.dumps({
        "ok": completed.returncode == 0,
        "action": action,
        "returncode": completed.returncode,
        "stdout": completed.stdout[-2000:],
        "stderr": completed.stderr[-2000:],
    }))
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
