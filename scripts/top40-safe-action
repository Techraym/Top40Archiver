#!/usr/bin/env python3
from __future__ import annotations

import json
import subprocess
import sys

ACTIONS = {
    "restart_web": ["systemctl", "restart", "top40-archiver-web.service"],
    "restart_download": ["systemctl", "restart", "top40-archiver-download.service"],
    "restart_ai": ["systemctl", "restart", "top40-archiver-ai.service"],
    "diagnostics": ["systemctl", "is-system-running"],
}


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in ACTIONS:
        print(json.dumps({"ok": False, "error": "action_not_allowed", "allowed": sorted(ACTIONS)}))
        return 2
    action = sys.argv[1]
    completed = subprocess.run(ACTIONS[action], capture_output=True, text=True, timeout=60, check=False)
    print(json.dumps({"ok": completed.returncode == 0, "action": action, "returncode": completed.returncode, "stdout": completed.stdout[-2000:], "stderr": completed.stderr[-2000:]}))
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
